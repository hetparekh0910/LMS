{
  "name": "lms",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "dev:api": "npm run dev -w @lms/api",
    "db:generate": "npm run generate -w @lms/db",
    "db:migrate": "npm run migrate -w @lms/db --",
    "db:seed": "npm run seed -w @lms/db",
    "test": "npm test -w @lms/api"
  },
  "devDependencies": {
    "@types/node": "^26.6.6"
  }
}
